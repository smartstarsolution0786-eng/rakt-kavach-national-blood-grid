Modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/rakt-kavach: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/rakt-kavach"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/rakt-kavach run dev"
cwd = "./artifacts/rakt-kavach"
waitForPort = 25231
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "25231"
BASE_PATH = "/"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
